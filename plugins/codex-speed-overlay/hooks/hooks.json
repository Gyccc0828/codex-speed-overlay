{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "wscript.exe //B //NoLogo \"${PLUGIN_ROOT}/scripts/start-overlay.vbs\"",
            "async": true,
            "timeout": 3
          }
        ]
      }
    ]
  }
}
